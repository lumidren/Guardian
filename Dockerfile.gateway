# GUARDIAN Gateway Security Daemon Dockerfile
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (iptables, net-tools, libpcap)
RUN apt-get update && apt-get install -y --no-install-recommends \
    iptables \
    tcpdump \
    libpcap-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency requirements
COPY requirements.txt pyproject.toml /app/

# Install python packages
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir httpx

# Copy source code and dashboard
COPY guardian/ /app/guardian/
COPY simulation/ /app/simulation/
COPY dashboard/ /app/dashboard/
COPY README.md /app/

# Set Python path
ENV PYTHONPATH=/app
ENV PORT=8000

EXPOSE 8000

# Start gateway with uvicorn
CMD ["uvicorn", "guardian.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
